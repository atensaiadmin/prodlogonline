# Cloudflare Pages build runs `npx @cloudflare/next-on-pages@1`.
# next-on-pages@1.x and its bundled wrangler@4.x declare incompatible
# peer ranges for @cloudflare/workers-types (^4 vs ^5), which makes npm's
# strict resolver fail with ERESOLVE. These are both optional peers, so
# skipping the strict check is safe and lets the build proceed.
legacy-peer-deps=true
